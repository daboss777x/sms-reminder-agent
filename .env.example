# ─── Trigger.dev ──────────────────────────────────────────────────────────────
# cloud.trigger.dev → Builder Hub → Settings → API keys (dev environment).
TRIGGER_SECRET_KEY=

# ─── Google Sheets (service account) ──────────────────────────────────────────
# 1. console.cloud.google.com → new project
# 2. APIs & Services → enable "Google Sheets API"
# 3. Credentials → Create credentials → Service account → Keys → Add key → JSON
# 4. Share the spreadsheet with the client_email below as an EDITOR,
#    otherwise the API returns 403 even with a valid key.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The full private_key from the JSON, in double quotes, newlines left as \n
GOOGLE_PRIVATE_KEY=""
# The /d/<THIS_PART>/edit segment of the spreadsheet URL
GOOGLE_SHEET_ID=
# The tab name, e.g. Appointments
GOOGLE_SHEET_NAME=

# ─── EgoSMS (the only SMS provider) ──────────────────────────────────────────
# API username and API KEY from your EgoSMS dashboard (not the web login password).
# Endpoint: https://comms.egosms.co/api/v1/json/
EGOSMS_USERNAME=
EGOSMS_PASSWORD=
# OPTIONAL — leave blank if you have no registered sender ID.
# Blank falls back to the EgoSMS platform default ("EgoSMS"), which is what
# recipients will see as the sender. Max 11 characters if you do set one.
EGOSMS_SENDER_ID=

# ─── OpenAI (gpt-5.6-luna drafts the message body) ────────────────────────────
# platform.openai.com → API keys
OPENAI_API_KEY=

# ─── Clinic ───────────────────────────────────────────────────────────────────
# Appears in the SMS signature
CLINIC_NAME=

# ─── Testing ──────────────────────────────────────────────────────────────────
# While set, EVERY reminder is redirected to this number and the sheet is NOT
# written to. Format: 256XXXXXXXXX. Leave blank / remove to go live.
TEST_PHONE_NUMBER=
